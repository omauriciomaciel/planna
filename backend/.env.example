APP_ENV=development
DATABASE_URL=postgresql+asyncpg://planna:planna@localhost:5433/planna
COOKIE_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Preços do modelo por 1 milhão de tokens; mantenha 0 para registrar apenas o uso.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
CORS_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
LOG_LEVEL=INFO
# Protege GET /operations/metrics; use pelo menos 32 caracteres.
METRICS_TOKEN=

# Em desenvolvimento, o link é exibido no terminal se SMTP_HOST estiver vazio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=acesso@planna.local
SMTP_USE_TLS=true

# Open Finance (Pluggy). O webhook precisa ser uma URL pública HTTPS.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_URL=
PLUGGY_WEBHOOK_SECRET=
